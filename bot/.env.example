# =============================================================
# RUNTIME SCOPE
# =============================================================
# ENABLE_TRADING          : Set to true to allow order execution. 
#                           Keep false for dry runs and backtests.
# PLOT_ENABLED            : Enables plotting output during calibration.
# SYMBOLS                 : Comma-separated symbols to watch.
# CANDLE_COUNT            : Number of bars pulled per refresh for analysis context.
#                           Higher values = more historical data for indicator calc.
# REFRESH_CANDLE_COUNT    : Plot-refresh stride during backtest replay.
# POLL_SECONDS            : Main loop sleep interval. Lower = faster reaction but more CPU.
# POSITION_MONITOR_SECONDS: How often to print open position status.
# ACCOUNT_MONITOR_SECONDS : How often to print account balance/equity.
# PRICE_ACTION_COOLDOWN_MINUTES: Minimum delay between price-action executions.
#                               Prevents overtrading on same signal.
# =============================================================
ENABLE_TRADING=true
PLOT_ENABLED=true
SYMBOLS=XAUUSD
CANDLE_COUNT=1000                              # 1000 candles for robust indicator calculation
REFRESH_CANDLE_COUNT=5
POLL_SECONDS=1                              # Fast polling for quick signal detection
POSITION_MONITOR_SECONDS=15
ACCOUNT_MONITOR_SECONDS=30
PRICE_ACTION_COOLDOWN_MINUTES=60              # 1 hour cooldown between signals

# =============================================================
# CHART SETTINGS
# =============================================================
# CHART_UPDATE_SECONDS    : Minimum interval between chart redraws.
# CHART_WIDTH/HEIGHT      : Required chart size in inches.
# CHART_TP_MARKER_SIZE    : Size of take-profit markers on chart.
# CHART_SL_MARKER_SIZE    : Size of stop-loss markers on chart.
# CHART_ENTRY_MARKER_SIZE : Size of entry markers on chart.
# CHART_DIRECTION_MARKER_SIZE: Size of direction arrows on chart.
# PLOT_LTF_CANDLES        : Number of visible candles in lower timeframe panel.
# PLOT_HTF_CANDLES        : Number of visible candles in higher timeframe panel.
# =============================================================
CHART_UPDATE_SECONDS=0.5
CHART_WIDTH=14
CHART_HEIGHT=8
CHART_TP_MARKER_SIZE=5
CHART_SL_MARKER_SIZE=5
CHART_ENTRY_MARKER_SIZE=5
CHART_DIRECTION_MARKER_SIZE=5
PLOT_LTF_CANDLES=100
PLOT_HTF_CANDLES=100

# =============================================================
# DATABASE AND LOGGING
# =============================================================
# CTRADER_POSITION_DB_PATH: SQLite path for tracked open positions.
# LOG_LEVEL               : Logging verbosity (DEBUG, INFO, WARNING, ERROR).
# STRATEGY_EVAL_LOG_VERBOSE: Enable detailed strategy evaluation logging.
# =============================================================
CTRADER_POSITION_DB_PATH=position-data/gold_positions.sqlite3
LOG_LEVEL=DEBUG
STRATEGY_EVAL_LOG_VERBOSE=true

# =============================================================
# BACKTEST SETTINGS - OPTIMIZED FOR H4/M30
# =============================================================
# BACKTEST_DATA_DIR       : CSV file or folder that contains OHLC data.
# BACKTEST_INITIAL_BALANCE: Starting account balance for the backtest.
# BACKTEST_FIXED_VOLUME   : Fixed trade size. 0.0 uses the engine default.
# BACKTEST_RESULTS_SUBDIR : Folder name used inside backtest/results.
# BACKTEST_SPEED          : Replay speed for backtest execution. 
#                           Examples: 5ms, 100ms, 1s.
# BACKTEST_LOOKBACK_VALUE : Use last X units only (0 disables lookback filter).
# BACKTEST_LOOKBACK_UNIT  : weeks or months.
# BACKTEST_USE_BROKER_PROFILE: Use live broker symbol/account metadata.
# BACKTEST_SIMULATE_MARGIN_REJECTION: Skip trades when margin insufficient.
# BACKTEST_VOLUME_MIN/MAX/STEP: Fallback lot constraints.
# BACKTEST_MAX_VOLUME_CAP : Optional hard lot cap; 0 disables cap.
# BACKTEST_DEFAULT_CONTRACT_SIZE: Used for margin estimate fallback.
# BACKTEST_DEFAULT_LEVERAGE: Used when account leverage is unavailable.
# BACKTEST_MARGIN_AVAILABLE_RATIO: Portion of equity treated as available margin.
# BACKTEST_WARN_VOLUME_ABOVE: Warn once when trade volume reaches this level.
# BACKTEST_WARN_EQUITY_MULTIPLIER: Warn once when equity exceeds this multiple.
# =============================================================
BACKTEST_DATA_DIR=gold_bot/backtest/data/
BACKTEST_INITIAL_BALANCE=1000
BACKTEST_FIXED_VOLUME=0.01
BACKTEST_RESULTS_SUBDIR=results
BACKTEST_SPEED=500ms
BACKTEST_LOOKBACK_VALUE=4
BACKTEST_LOOKBACK_UNIT=weeks
BACKTEST_USE_BROKER_PROFILE=false
BACKTEST_SIMULATE_MARGIN_REJECTION=true
BACKTEST_VOLUME_MIN=0.01
BACKTEST_VOLUME_MAX=0.01
BACKTEST_VOLUME_STEP=0.01
BACKTEST_MAX_VOLUME_CAP=0.01
BACKTEST_DEFAULT_CONTRACT_SIZE=100.0
BACKTEST_DEFAULT_LEVERAGE=500.0
BACKTEST_MARGIN_AVAILABLE_RATIO=0.95
BACKTEST_WARN_VOLUME_ABOVE=0.05
BACKTEST_WARN_EQUITY_MULTIPLIER=20.0
MAX_CYCLES=0

# =============================================================
# STRATEGY SELECTION
# =============================================================
# GOLD_STRATEGY_NAMES: Comma-separated strategies to enable.
# Supported values: trend_following, price_action, session_breakout, ema_crossover.
# =============================================================
GOLD_STRATEGY_NAMES=ema_crossover

# =============================================================
# EMA CROSSOVER STRATEGY CONFIG
# =============================================================
# TIMEFRAMES: independent state-machine lanes for this strategy.
# EMA_CROSSOVER_GOLD_STOP_LOSS_PIPS / TAKE_PROFIT_PIPS accept 1 value
# or a comma list matching TIMEFRAMES order.
# =============================================================
EMA_CROSSOVER_EMA_FAST=50
EMA_CROSSOVER_EMA_SLOW=200
EMA_CROSSOVER_TIMEFRAMES=H1
EMA_CROSSOVER_STOP_LOSS_PIPS=550
EMA_CROSSOVER_TAKE_PROFIT_PIPS=1100
EMA_CROSSOVER_GOLD_STOP_LOSS_PIPS=750
EMA_CROSSOVER_GOLD_TAKE_PROFIT_PIPS=900
EMA_CROSSOVER_RISK_REWARD_RATIO=2
EMA_CROSSOVER_GLOBAL_POSITION_LIMIT=4

# =============================================================
# LADDER / MULTI-ENTRY SETTINGS
# =============================================================
# GOLD_ENABLE_MULTI_ENTRY: Turns laddered entries on or off.
#   - When enabled, a single signal creates multiple planned entries
#   - Each subsequent entry is scaled by GOLD_LADDER_STEP_RATIO
#   - Example: If step ratio is 0.4, 2nd entry is at 40% of 1st entry distance
# GOLD_LADDER_ENTRIES    : Number of ladder levels to produce.
# GOLD_LADDER_STEP_RATIO : Multiplier that scales each subsequent TP ladder level.
# GOLD_FIXED_LOT_SIZE    : If > 0, overrides default fixed execution lot.
# =============================================================
GOLD_ENABLE_MULTI_ENTRY=false
GOLD_LADDER_ENTRIES=1
GOLD_LADDER_STEP_RATIO=0.4
GOLD_FIXED_LOT_SIZE=0.01

# =============================================================
# STRATEGY PRESETS - H4/M30 OPTIMIZED PROFILE
# =============================================================
# LIST MAPPING RULES:
# =============================================================
# 1. *_LTF and *_HTF accept comma-separated lists and must have equal length.
#    - Position 0: First timeframe pair (e.g., M15/H1)
#    - Position 1: Second timeframe pair (e.g., M30/H4)
#
# 2. *_GOLD_STOP_LOSS_PIPS and *_GOLD_TAKE_PROFIT_PIPS can be:
#    - Single value: Applied to ALL timeframe pairs
#    - Comma-separated list: Must match number of timeframe pairs
#      - Position 0: SL/TP for first timeframe pair
#      - Position 1: SL/TP for second timeframe pair
#
# 3. The bot extracts SL/TP values based on the current timeframe pair index.
#    Example: If using M30/H4 (index 1), it uses SL_PIPS[1] and TP_PIPS[1].
# =============================================================

# =============================================================
# TREND FOLLOWING STRATEGY
# =============================================================
# DESCRIPTION: Catches major daily/weekly swings by following the trend.
# ENTRY LOGIC: 
#   - M15/M30 for entry signals
#   - H1/H4 for trend filter (price above/below EMA)
# SIGNAL: Price pullback to EMA with confirmation candle
# EXIT: Fixed TP or trailing stop
#
# TIMEFRAME PAIRS:
#   - Pair 0: M15 entry, H1 trend filter (shorter-term swings)
#   - Pair 1: M30 entry, H4 trend filter (longer-term trends)
#
# SL/TP VALUES:
#   - Pair 0 (M15/H1): SL=520, TP=800 (1:1.5 R:R)
#   - Pair 1 (M30/H4): SL=650, TP=1500 (1:2.3 R:R)
#
# NOTE: Trend following with 1:1.5 R:R requires >40% win rate.
# The wider SL on H4 gives more room for trend continuation.
# =============================================================
TREND_FOLLOWING_LTF=M15,M30
TREND_FOLLOWING_HTF=H1,H4
TREND_FOLLOWING_GOLD_STOP_LOSS_PIPS=520,650            # Pair 0: 520, Pair 1: 650
TREND_FOLLOWING_GOLD_TAKE_PROFIT_PIPS=800,1500         # Pair 0: 800, Pair 1: 1500

# =============================================================
# PRICE ACTION STRATEGY
# =============================================================
# DESCRIPTION: Trades breakouts and retests of structural pivots.
# ENTRY LOGIC:
#   - M15/M30 for identifying key S/R levels
#   - H1/H4 for major structural pivot confirmation
# SIGNAL: Breakout of key level with confirmation candle close
# EXIT: Fixed TP at next structural level
#
# TIMEFRAME PAIRS:
#   - Pair 0: M15 entry, H1 structure (shorter-term pivots)
#   - Pair 1: M30 entry, H4 structure (major weekly pivots)
#
# SL/TP VALUES:
#   - Pair 0 (M15/H1): SL=600, TP=1800 (1:3 R:R)
#   - Pair 1 (M30/H4): SL=750, TP=2250 (1:3 R:R)
#
# NOTE: 1:3 R:R requires only 25% win rate to break even.
# Structural levels provide high-probability setups.
# =============================================================
PRICE_ACTION_LTF=M15,M30
PRICE_ACTION_HTF=H1,H4
PRICE_ACTION_GOLD_STOP_LOSS_PIPS=600,750               # Pair 0: 600, Pair 1: 750
PRICE_ACTION_GOLD_TAKE_PROFIT_PIPS=1800,2250           # Pair 0: 1800, Pair 1: 2250

# =============================================================
# SESSION BREAKOUT STRATEGY
# =============================================================
# DESCRIPTION: Trades breakouts of Asian/London/NY session highs/lows.
# ENTRY LOGIC:
#   - M15/M30 for identifying session range
#   - H1/H4 for session boundary confirmation
# SIGNAL: Price breaks above/below session range with candle close
# EXIT: Fixed TP at 1.5x session range width
#
# TIMEFRAME PAIRS:
#   - Pair 0: M15 entry, H1 session (Asian/London sessions)
#   - Pair 1: M30 entry, H4 session (NY/London sessions)
#
# SL/TP VALUES:
#   - Pair 0 (M15/H1): SL=500, TP=1500 (1:3 R:R)
#   - Pair 1 (M30/H4): SL=650, TP=1950 (1:3 R:R)
#
# NOTE: Session breakouts work best in first 2 hours of London/NY opens.
# Wider SL on H4 gives room for session volatility spikes.
# =============================================================
SESSION_BREAKOUT_LTF=M15,M30
SESSION_BREAKOUT_HTF=H1,H4
SESSION_BREAKOUT_GOLD_STOP_LOSS_PIPS=500,650           # Pair 0: 500, Pair 1: 650
SESSION_BREAKOUT_GOLD_TAKE_PROFIT_PIPS=1500,1950       # Pair 0: 1500, Pair 1: 1950

# =============================================================
# INDICATOR AND EXECUTION CAPS
# =============================================================
# GOLD_EMA_FAST          : Fast EMA period for crossover signals.
#                         : Smaller = more sensitive to price changes.
# GOLD_EMA_SLOW          : Slow EMA period for crossover signals.
#                         : Larger = smoother trend identification.
# GOLD_EMA_TREND_PERIOD  : Long-term EMA for trend bias filter.
#                         : Price above = bullish, below = bearish.
# GOLD_MAX_DAILY_TRADES  : Hard cap on daily trade count.
#                         : Prevents overtrading and protects account.
# =============================================================
GOLD_EMA_FAST=9
GOLD_EMA_SLOW=21
GOLD_EMA_TREND_PERIOD=200
GOLD_MAX_DAILY_TRADES=15