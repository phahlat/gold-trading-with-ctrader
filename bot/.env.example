# =============================================================
# CTRADER CONNECTION
# Required for live/paper trading. Not used in backtest mode.
# CTRADER_CLIENT_ID     : cTrader Open API application ID.
# CTRADER_CLIENT_SECRET : cTrader Open API application secret.
# CTRADER_ACCESS_TOKEN  : OAuth access token.
# CTRADER_REFRESH_TOKEN : OAuth refresh token.
# CTRADER_ACCOUNT_ID    : Optional specific account ID (0 auto-selects).
# CTRADER_HOST          : live or demo.
# CTRADER_REQUEST_TIMEOUT_SECONDS : per-request timeout.
# CTRADER_CONNECT_TIMEOUT_SECONDS : initial connect timeout.
# CTRADER_RECONNECT_ATTEMPTS      : reconnect tries after connection loss.
# CTRADER_RECONNECT_WAIT_SECONDS  : wait between reconnect attempts.
# =============================================================
CTRADER_CLIENT_ID=33954_lNwnc0y6W9fcMcWtzRrbbD7qaLAHvwubH16z5miVcZAavLc02Q
CTRADER_CLIENT_SECRET=7DPEupXnEHOlMN3LpZOeIFKOjsvt76OZSGxDb1X4ogqcCkiR3a
CTRADER_ACCESS_TOKEN=rrUcvIODE2CN7OCK6uO7skvWC-UIkC64wAXXdIuuFa8
CTRADER_REFRESH_TOKEN=gO5pxq1bRO5hOBDWK_KRT2kFJjTJpj9k6OipzYyYMkQ
CTRADER_ACCOUNT_ID=0
CTRADER_LIVE_ACCOUNT_ID=45106429
CTRADER_DEMO_ACCOUNT_ID=47296160
CTRADER_HOST=demo
CTRADER_REQUEST_TIMEOUT_SECONDS=12
CTRADER_CONNECT_TIMEOUT_SECONDS=15
CTRADER_RECONNECT_ATTEMPTS=5
CTRADER_RECONNECT_WAIT_SECONDS=30

# =============================================================
# RUNTIME SCOPE
# Controls whether the bot sends trades and how much information
# it prints while running.
# ENABLE_TRADING : Set to true to allow order execution. Keep false
#                  for dry runs and backtests.
# PLOT_ENABLED   : Enables plotting output during calibration.
# SYMBOLS        : Comma-separated symbols to watch.
# CANDLE_COUNT   : Number of bars pulled per refresh for analysis context.
# REFRESH_CANDLE_COUNT: Plot-refresh stride during backtest replay.
# POLL_SECONDS   : Main loop sleep interval.
# POSITION_MONITOR_SECONDS/ACCOUNT_MONITOR_SECONDS: Monitoring print cadence.
# CHART_UPDATE_SECONDS: Minimum interval between chart redraws.
# CHART_WIDTH/CHART_HEIGHT: Required chart size in inches.
# PLOT_LTF_CANDLES/PLOT_HTF_CANDLES: Visible bars in each chart panel.
# MAX_CYCLES     : Maximum number of monitoring cycles. 0 means no limit.
# CTRADER_POSITION_DB_PATH: SQLite path for tracked open positions.
# LOG_LEVEL      : Logging verbosity (DEBUG, INFO, WARNING, ERROR). Default DEBUG.
# STRATEGY_EVAL_LOG_VERBOSE: Emits per-strategy evaluation/decision logs in live mode.
# =============================================================
ENABLE_TRADING=true
PLOT_ENABLED=false
SYMBOLS=XAUUSD # e.g. XAUUSD,EURUSD,GBPUSD
CANDLE_COUNT=100
REFRESH_CANDLE_COUNT=5
POLL_SECONDS=0.2
POSITION_MONITOR_SECONDS=10
ACCOUNT_MONITOR_SECONDS=30

# Chart settings
CHART_UPDATE_SECONDS=0.5
CHART_WIDTH=18
CHART_HEIGHT=8
CHART_TP_MARKER_SIZE=5
CHART_SL_MARKER_SIZE=5
CHART_ENTRY_MARKER_SIZE=5
CHART_DIRECTION_MARKER_SIZE=5
PLOT_LTF_CANDLES=75
PLOT_HTF_CANDLES=150

# DB and logging
CTRADER_POSITION_DB_PATH=logs/gold_positions.sqlite3
LOG_LEVEL=INFO
STRATEGY_EVAL_LOG_VERBOSE=true

# =============================================================
# BACKTEST SETTINGS
# Used when running the bot against historical CSV data.
# BACKTEST_DATA_DIR      : CSV file or folder that contains OHLC data.
# BACKTEST_INITIAL_BALANCE: Starting account balance for the backtest.
# BACKTEST_FIXED_VOLUME  : Fixed trade size. 0.0 uses the engine default.
# BACKTEST_RESULTS_SUBDIR: Folder name used inside backtest/results.
# BACKTEST_SPEED         : Replay speed for backtest execution. Examples: 100ms or 1s.
# BACKTEST_LOOKBACK_VALUE: Use last X units only (0 disables lookback filter).
# BACKTEST_LOOKBACK_UNIT : weeks or months.
# BACKTEST_USE_BROKER_PROFILE: Use live broker symbol/account metadata when available.
# BACKTEST_SIMULATE_MARGIN_REJECTION: Skip trades when estimated required margin exceeds available margin.
# BACKTEST_VOLUME_MIN/MAX/STEP: Fallback lot constraints if MT5 profile is unavailable.
# BACKTEST_MAX_VOLUME_CAP: Optional hard lot cap; 0 disables cap.
# BACKTEST_DEFAULT_CONTRACT_SIZE: Used for margin estimate fallback.
# BACKTEST_DEFAULT_LEVERAGE: Used when account leverage is unavailable.
# BACKTEST_MARGIN_AVAILABLE_RATIO: Portion of equity treated as available margin.
# BACKTEST_WARN_VOLUME_ABOVE: Warn once when trade volume reaches this level.
# BACKTEST_WARN_EQUITY_MULTIPLIER: Warn once when equity exceeds this multiple of start balance.
# =============================================================
BACKTEST_DATA_DIR=gold_bot/backtest/data/
BACKTEST_INITIAL_BALANCE=1000
BACKTEST_FIXED_VOLUME=0.01
BACKTEST_RESULTS_SUBDIR=gold_bot
BACKTEST_SPEED=500ms
BACKTEST_LOOKBACK_VALUE=4
BACKTEST_LOOKBACK_UNIT=weeks
BACKTEST_USE_BROKER_PROFILE=false
BACKTEST_SIMULATE_MARGIN_REJECTION=true
BACKTEST_VOLUME_MIN=0.01
BACKTEST_VOLUME_MAX=50.0
BACKTEST_VOLUME_STEP=0.01
BACKTEST_MAX_VOLUME_CAP=1.0
BACKTEST_DEFAULT_CONTRACT_SIZE=100.0
BACKTEST_DEFAULT_LEVERAGE=100.0
BACKTEST_MARGIN_AVAILABLE_RATIO=0.95
BACKTEST_WARN_VOLUME_ABOVE=1.0
BACKTEST_WARN_EQUITY_MULTIPLIER=20.0
MAX_CYCLES=0

# =============================================================
# STRATEGY SELECTION
# GOLD_STRATEGY_NAMES: Comma-separated strategies to enable.
#                      Supported values: trend_following, price_action,
#                      session_breakout.
# =============================================================
GOLD_STRATEGY_NAMES=trend_following,price_action,session_breakout

# =============================================================
# LADDER / MULTI-ENTRY
# Controls whether a single signal becomes multiple planned entries.
# GOLD_ENABLE_MULTI_ENTRY: Turns laddered entries on or off.
# GOLD_LADDER_ENTRIES    : Number of ladder levels to produce.
# GOLD_LADDER_STEP_RATIO : Multiplier that scales each subsequent TP ladder level.
# GOLD_FIXED_LOT_SIZE    : If > 0, overrides default fixed execution lot.
# =============================================================
GOLD_ENABLE_MULTI_ENTRY=true
GOLD_LADDER_ENTRIES=2
GOLD_LADDER_STEP_RATIO=2
GOLD_FIXED_LOT_SIZE=0.01

# =============================================================
# STRATEGY PRESETS (recommended from docs/STRATEGIES.md)
# Each strategy can run one or more LTF/HTF pairs.
# List format rules:
# 1) <STRATEGY>_LTF and <STRATEGY>_HTF use comma-separated lists.
# 2) LTF and HTF lists must have the same item count.
# 3) *_GOLD_STOP_LOSS_PIPS and *_GOLD_TAKE_PROFIT_PIPS can be:
#    - one value (applied to all pairs), or
#    - a list with the same item count as LTF/HTF.
# TREND_FOLLOWING_*      : Conservative trend profile.
# PRICE_ACTION_*         : Structure breakout/rejection profile.
# SESSION_BREAKOUT_*     : Session range expansion profile.
# =============================================================
TREND_FOLLOWING_LTF=M15,M30
TREND_FOLLOWING_HTF=H1,H4
TREND_FOLLOWING_GOLD_STOP_LOSS_PIPS=120,140
TREND_FOLLOWING_GOLD_TAKE_PROFIT_PIPS=250,320

PRICE_ACTION_LTF=M5,M15
PRICE_ACTION_HTF=M30,H1
PRICE_ACTION_GOLD_STOP_LOSS_PIPS=80,100
PRICE_ACTION_GOLD_TAKE_PROFIT_PIPS=180,240

SESSION_BREAKOUT_LTF=M15,M30
SESSION_BREAKOUT_HTF=H1,H4
SESSION_BREAKOUT_GOLD_STOP_LOSS_PIPS=100
SESSION_BREAKOUT_GOLD_TAKE_PROFIT_PIPS=220,300

# =============================================================
# INDICATOR AND EXECUTION CAPS
# GOLD_EMA_FAST/SLOW     : EMA periods for trend and crossover logic.
# GOLD_EMA_TREND_PERIOD  : Long-term EMA for trend bias.
# GOLD_MAX_DAILY_TRADES  : Hard cap on daily trade count.
# =============================================================
GOLD_EMA_FAST=9
GOLD_EMA_SLOW=21
GOLD_EMA_TREND_PERIOD=200
GOLD_MAX_DAILY_TRADES=100
